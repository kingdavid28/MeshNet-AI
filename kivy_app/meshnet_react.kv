#:kivy 2.3.0

<MeshNetRootWidget>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.04, 0.09, 0.14, 1
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Header
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(60)
        padding: dp(16)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: 0.06, 0.11, 0.23, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: 0.7
            spacing: dp(10)
            
            BoxLayout:
                size_hint_x: None
                width: dp(32)
                height: dp(32)
                canvas.before:
                    Color:
                        rgba: 0.98, 0.45, 0.09, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8), dp(8), dp(8), dp(8)]
            
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                
                Label:
                    text: 'MeshNet AI'
                    font_size: dp(16)
                    bold: True
                    color: 0.91, 0.93, 0.97, 1
                    size_hint_y: None
                    height: dp(20)
                
                Label:
                    text: 'Emergency Routing v2.4'
                    font_size: dp(9)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(12)
        
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: 0.3
            padding: dp(10)
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: 0.13, 0.77, 0.37, 0.1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(8), dp(8), dp(8), dp(8)]
                Color:
                    rgba: 0.13, 0.77, 0.37, 0.2
                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8), dp(8), dp(8), dp(8)]
            
            Label:
                text: '●'
                font_size: dp(12)
                color: 0.13, 0.77, 0.37, 1
                size_hint_x: None
                width: dp(12)
            
            Label:
                text: 'Mesh (0)'
                font_size: dp(10)
                color: 0.13, 0.77, 0.37, 1
    
    # Network Health Card
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(100)
        padding: dp(16)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: 0.07, 0.17, 0.35, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12), dp(12), dp(12), dp(12)]
            Color:
                rgba: 0.36, 0.55, 0.85, 0.2
            Line:
                rectangle: self.x, self.y, self.width, self.height
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12), dp(12), dp(12), dp(12)]
        
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(20)
            spacing: dp(8)
            
            BoxLayout:
                size_hint_x: None
                width: dp(8)
                height: dp(8)
                canvas.before:
                    Color:
                        rgba: 0.75, 0.85, 0.99, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size
            
            Label:
                text: 'Mesh Standby'
                font_size: dp(12)
                bold: True
                color: 0.75, 0.85, 0.99, 1
                size_hint_x: 0.5
            
            Label:
                text: '0 nodes online'
                font_size: dp(12)
                color: 0.48, 0.61, 0.77, 1
        
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(12)
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.33
                canvas.before:
                    Color:
                        rgba: 0.04, 0.11, 0.23, 0.6
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8), dp(8), dp(8), dp(8)]
                
                Label:
                    text: '0'
                    font_size: dp(20)
                    bold: True
                    color: 0.91, 0.93, 0.97, 1
                    size_hint_y: None
                    height: dp(25)
                
                Label:
                    text: 'online'
                    font_size: dp(10)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(12)
                
                Label:
                    text: 'Nodes'
                    font_size: dp(9)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(13)
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.33
                canvas.before:
                    Color:
                        rgba: 0.04, 0.11, 0.23, 0.6
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8), dp(8), dp(8), dp(8)]
                
                Label:
                    text: '—'
                    font_size: dp(20)
                    bold: True
                    color: 0.91, 0.93, 0.97, 1
                    size_hint_y: None
                    height: dp(25)
                
                Label:
                    text: 'avg'
                    font_size: dp(10)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(12)
                
                Label:
                    text: 'Signal'
                    font_size: dp(9)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(13)
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.33
                canvas.before:
                    Color:
                        rgba: 0.04, 0.11, 0.23, 0.6
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8), dp(8), dp(8), dp(8)]
                
                Label:
                    text: '—'
                    font_size: dp(20)
                    bold: True
                    color: 0.91, 0.93, 0.97, 1
                    size_hint_y: None
                    height: dp(25)
                
                Label:
                    text: 'p95'
                    font_size: dp(10)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(12)
                
                Label:
                    text: 'Latency'
                    font_size: dp(9)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_y: None
                    height: dp(13)
    
    # SOS Button
    Button:
        text: 'SOS ALERT'
        font_size: dp(20)
        bold: True
        size_hint_y: None
        height: dp(80)
        margin: dp(16)
        background_normal: ''
        background_down: ''
        canvas.before:
            Color:
                rgba: 0.98, 0.45, 0.09, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16), dp(16), dp(16), dp(16)]
            Color:
                rgba: 0.98, 0.45, 0.09, 0.35
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16), dp(16), dp(16), dp(16)]
    
    # Action Grid
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(160)
        padding: dp(16)
        spacing: dp(12)
        
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.5
            spacing: dp(12)
            
            Button:
                text: 'Medical Request'
                font_size: dp(16)
                bold: True
                size_hint_y: 0.5
                background_normal: ''
                background_down: ''
                canvas.before:
                    Color:
                        rgba: 0.07, 0.17, 0.35, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]
                    Color:
                        rgba: 0.36, 0.55, 0.85, 0.2
                    Line:
                        rectangle: self.x, self.y, self.width, self.height
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12), dp(12), dp(12), dp(12)]
            
            Button:
                text: 'Share GPS'
                font_size: dp(16)
                bold: True
                size_hint_y: 0.5
                background_normal: ''
                background_down: ''
                canvas.before:
                    Color:
                        rgba: 0.07, 0.17, 0.35, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]
                    Color:
                        rgba: 0.36, 0.55, 0.85, 0.2
                    Line:
                        rectangle: self.x, self.y, self.width, self.height
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12), dp(12), dp(12), dp(12)]
        
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.5
            spacing: dp(12)
            
            Button:
                text: 'All Clear'
                font_size: dp(16)
                bold: True
                size_hint_y: 0.5
                background_normal: ''
                background_down: ''
                canvas.before:
                    Color:
                        rgba: 0.07, 0.17, 0.35, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]
                    Color:
                        rgba: 0.36, 0.55, 0.85, 0.2
                    Line:
                        rectangle: self.x, self.y, self.width, self.height
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12), dp(12), dp(12), dp(12)]
            
            Button:
                text: 'Relay Mode'
                font_size: dp(16)
                bold: True
                size_hint_y: 0.5
                background_normal: ''
                background_down: ''
                canvas.before:
                    Color:
                        rgba: 0.07, 0.17, 0.35, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]
                    Color:
                        rgba: 0.36, 0.55, 0.85, 0.2
                    Line:
                        rectangle: self.x, self.y, self.width, self.height
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(12), dp(12), dp(12), dp(12)]
    
    # Recent Activity
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(120)
        padding: dp(16)
        spacing: dp(8)
        
        Label:
            text: 'Recent Activity'
            font_size: dp(14)
            bold: True
            color: 0.48, 0.61, 0.77, 1
            size_hint_y: None
            height: dp(20)
        
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(80)
            spacing: dp(8)
            
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(35)
                padding: dp(12)
                spacing: dp(8)
                canvas.before:
                    Color:
                        rgba: 0.07, 0.17, 0.35, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8), dp(8), dp(8), dp(8)]
                    Color:
                        rgba: 0.98, 0.45, 0.09, 0.3
                    Rectangle:
                        pos: [self.x, self.y]
                        size: [dp(4), self.height]
                
                Label:
                    text: 'System'
                    font_size: dp(12)
                    bold: True
                    color: 0.91, 0.93, 0.97, 1
                    size_hint_x: 0.3
                
                Label:
                    text: 'Mesh network initialized'
                    font_size: dp(12)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_x: 0.7
                
                Label:
                    text: '12:00'
                    font_size: dp(10)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_x: None
                    width: dp(40)
            
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(35)
                padding: dp(12)
                spacing: dp(8)
                canvas.before:
                    Color:
                        rgba: 0.07, 0.17, 0.35, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8), dp(8), dp(8), dp(8)]
                    Color:
                        rgba: 0.13, 0.77, 0.37, 0.3
                    Rectangle:
                        pos: [self.x, self.y]
                        size: [dp(4), self.height]
                
                Label:
                    text: 'Node'
                    font_size: dp(12)
                    bold: True
                    color: 0.91, 0.93, 0.97, 1
                    size_hint_x: 0.3
                
                Label:
                    text: 'Device registered'
                    font_size: dp(12)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_x: 0.7
                
                Label:
                    text: '12:01'
                    font_size: dp(10)
                    color: 0.48, 0.61, 0.77, 1
                    size_hint_x: None
                    width: dp(40)
    
    # Bottom Navigation
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(60)
        canvas.before:
            Color:
                rgba: 0.04, 0.08, 0.15, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        Button:
            text: 'Home'
            font_size: dp(12)
            bold: True
            size_hint_x: 0.2
            background_normal: ''
            background_down: ''
            canvas.before:
                Color:
                    rgba: 0.98, 0.45, 0.09, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
        
        Button:
            text: 'Alert'
            font_size: dp(12)
            size_hint_x: 0.2
            background_normal: ''
            background_down: ''
            canvas.before:
                Color:
                    rgba: 0.04, 0.08, 0.15, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
        
        Button:
            text: 'Map'
            font_size: dp(12)
            size_hint_x: 0.2
            background_normal: ''
            background_down: ''
            canvas.before:
                Color:
                    rgba: 0.04, 0.08, 0.15, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
        
        Button:
            text: 'Comms'
            font_size: dp(12)
            size_hint_x: 0.2
            background_normal: ''
            background_down: ''
            canvas.before:
                Color:
                    rgba: 0.04, 0.08, 0.15, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
        
        Button:
            text: 'Settings'
            font_size: dp(12)
            size_hint_x: 0.2
            background_normal: ''
            background_down: ''
            canvas.before:
                Color:
                    rgba: 0.04, 0.08, 0.15, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
